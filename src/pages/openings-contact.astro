---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { profile } from '../data/site';
import { legacy } from '../data/legacy';
const base = import.meta.env.BASE_URL;
const linkTo = (href: string) => `${base}${href}`.replace(/\/+/g, '/');
---

<BaseLayout title="Openings & Contact | Chi-Seng Lam" description="Research openings and contact information for Professor Chi-Seng Lam at the University of Macau.">
  <PageHero eyebrow="Openings / Contact" title="Join us in building more efficient energy systems." lead="Applications are welcomed from motivated candidates with strong interests in power electronics, integrated power management, renewable energy, and wireless power transfer." meta={['Master’s', 'PhD', 'Research assistant', 'Postdoctoral']} />

  <section class="section white">
    <div class="container contact-grid">
      <div>
        <p class="eyebrow">Opportunities</p>
        <h2 class="subhead">Who should apply</h2>
        <p>Professor Lam is currently looking for Master’s and PhD candidates, research assistants, and postdoctoral scholars with strong interests aligned with the group’s research.</p>
        <ul class="clean-list">
          <li><strong>Power electronics</strong><small>Converters, power quality, grid-connected systems, and control</small></li>
          <li><strong>Integrated circuits</strong><small>Power management ICs, DC–DC converters, and voltage references</small></li>
          <li><strong>Energy applications</strong><small>Photovoltaics, wireless power transfer, and smart grids</small></li>
        </ul>
        <h3 class="subhead funding-heading">Funding information</h3>
        <ul class="archive-list">
          {legacy.fundingLinks.map(([label, href]) => {
            const banner = label.includes('Postdoctoral')
              ? 'images/legacy/funding/um-macao-postdoctoral-fellowship.jpg'
              : 'images/legacy/funding/um-macao-phd-scholarship.jpg';
            return (
              <li class="funding-item">
                <a href={href} target="_blank" rel="noreferrer">{label} <span aria-hidden="true">↗</span></a>
                <a href={href} target="_blank" rel="noreferrer" class="funding-banner">
                  <img src={linkTo(banner)} alt={label} loading="lazy" decoding="async" />
                </a>
              </li>
            );
          })}
        </ul>
      </div>
      <div class="contact-card">
        <h2 class="subhead">Get in touch</h2>
        <div class="contact-line"><small>Email</small><a href={`mailto:${profile.email}`}><strong>{profile.email}</strong></a></div>
        <div class="contact-line"><small>Alternate email</small><a href={`mailto:${legacy.contact.alternateEmail}`}><strong>{legacy.contact.alternateEmail}</strong></a></div>
        <div class="contact-line"><small>Telephone / Fax</small><span>{legacy.contact.telephone}<br />Fax: {legacy.contact.fax}</span></div>
        <div class="contact-line"><small>Academic unit</small><span>State Key Laboratory of Analog and Mixed-Signal VLSI<br />Institute of Microelectronics<br />University of Macau</span></div>
        <div class="contact-line"><small>Location</small><span>{legacy.contact.office}</span></div>
        <div class="contact-line"><small>Application material</small><span>Send a concise email with your CV, academic background, research interests, and intended position.</span></div>
        <p style="margin:28px 0 0"><a class="button" href={`mailto:${profile.email}?subject=Prospective%20research%20candidate`}>Email Professor Lam <span aria-hidden="true">→</span></a></p>
      </div>
    </div>
  </section>

</BaseLayout>
